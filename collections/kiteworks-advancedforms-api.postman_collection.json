          "name": "Create an upload link for an Advanced Form submission",
          "request": {
            "name": "Create an upload link for an Advanced Form submission",
            "description": {
              "content": "### Description:\n  Creates a subfolder under the form owner's folder for the submission, then returns an upload link that the Advanced Form client can use to upload the submitted files.\n### Precondition:\n  Caller must be an Advanced Forms client.\n  The authenticated user must be the form owner.\n### Response:\n  Returns an upload link pointing to the newly created submission subfolder.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "advancedForms",
                ":id",
                "submissions"
