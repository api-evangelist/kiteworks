          "name": "Get card details",
          "request": {
            "name": "Get card details",
            "description": {
              "content": "### Description:\n  Returns the detailed information for a specific admin dashboard card.\n### Precondition:\n  The user must be an administrator with System or Application role.\n### Response:\n  Returns the details of the specified card.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "admin",
                "cards",
                "details"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "(Required) The type of card to retrieve details for.<br>`content_encryption` – Content encryption card.<br>`email_json_migration` – Email JSON migration card.<br>`system_security_scanning` – System security scanning card.<br>`events_table_monitor` – Events table monitor card.<br>`appadmin_db` – Application admin database card.<br>`sysadmin_db` – System admin database card.<br>`sysadmin_hosts` – System admin hosts card.<br>`epg_warnings` – EPG warnings card.<br>`safe_edit_server_health` – Safe edit server health card."
                },
                {
                  "disabled": false,
                  "key": "hostId",
                  "value": "<string>",
                  "description": "The unique identifier of the host to filter card data by."
                },
                {
                  "disabled": false,
                  "key": "volume",
                  "value": "<string>",
                  "description": "Filter results to a specific storage volume."
                },
                {
                  "disabled": false,
                  "key": "storageType",
                  "value": "<string>",
                  "description": "Filter results by storage type.<br>`user_files` – User file storage.<br>`replication_files` – Replication file storage."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of error detail records to return. Error details are not returned if not set or set to 0."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Number of error detail records to skip before returning results, for pagination."
                }
